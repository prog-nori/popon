# JSON配列。シェルとして解釈しません。
VOICEVOX_ARGS=[]
TTS_IDLE_MS=600000
TTS_START_TIMEOUT_MS=180000
AUTO_LEAVE=true
AUTO_LEAVE_MS=60000
READY_SOUND_PATH=assets/sounds/meet_style.wav
DICTIONARY_PATH=assets/dictionary.json
