DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3
VOICEVOX_SPEED=1.0
VOICEVOX_VOLUME=1.0
# external: 手動起動済み / process: 以下の実行ファイルを子プロセスとして管理
