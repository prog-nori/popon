DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3
VOICEVOX_SPEED=1.0
VOICEVOX_VOLUME=1.0
# external: 手動起動済み / process: 以下の実行ファイルを子プロセスとして管理
TTS_MODE=external
VOICEVOX_EXECUTABLE=
# JSON配列。シェルとして解釈しません。
VOICEVOX_ARGS=[]
TTS_IDLE_MS=600000
TTS_START_TIMEOUT_MS=180000
AUTO_LEAVE=true
AUTO_LEAVE_MS=60000
READY_SOUND_PATH=assets/sounds/meet_style.wav
DICTIONARY_PATH=assets/dictionary.json
# ローカル実行時の外部コマンド（空ならPATHから検索）
FFMPEG_PATH=
YT_DLP_PATH=

# AWSモード: 空なら従来どおりGateway経由で操作（AWSへの接続なし）。
SQS_QUEUE_URL=
AWS_DEFAULT_REGION=ap-northeast-1
ECS_CLUSTER=discord-bot-cluster
ECS_SERVICE=discord-bot-service
COMMAND_TTL_MS=300000
BOT_IDLE_MS=300000
# 現在のLambdaとの停止競合を防ぐ外部調停を準備するまでは、両方false。
AUTO_STOP_ENABLED=false
AUTO_STOP_COORDINATED=false
# 単一タスクの運用とIAM権限を確認後に限りtrue。既定は停止操作を行わない。
ECS_STOP_ON_FATAL=false
