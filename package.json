{
  "name": "popon-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "register": "tsx --env-file=.env src/register.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "prettier --write src tests *.json *.js"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "@discordjs/voice": "0.19.2",
    "cheerio": "1.1.2",
    "ipaddr.js": "2.2.0",
    "opusscript": "0.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "4.1.12",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.6.0"
  },
  "packageManager": "npm@11.21.1"
}
